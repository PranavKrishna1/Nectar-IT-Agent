# Copy this file to .env and fill in real values.
# See config.py for how each variable is used and its default.
#
# ============================================================================
# DEFAULTS ARE THE FREE-TIER SETUP. You only need TWO keys, and neither
# provider requires a credit card:
#
#   1. GEMINI_API_KEY    → https://aistudio.google.com/apikey
#   2. PINECONE_API_KEY  → https://app.pinecone.io  (Starter plan)
#
# Everything else below already has a working free default:
#   - Embeddings run on Pinecone's hosted Inference (same Pinecone key)
#   - Speech-to-text runs Whisper locally via faster-whisper (no key)
#   - Text-to-speech uses Microsoft Edge voices via edge-tts (no key)
# ============================================================================


# --- LLM provider ------------------------------------------------------
# Google AI Studio key. Free tier, no credit card. Get one at:
#   https://aistudio.google.com/apikey
# Keys start with "AIza". Paste the value only - no quotes, no spaces.
GEMINI_API_KEY=

# IMPORTANT - model choice controls your free daily quota.
#
# Pin an explicit STABLE model. Do NOT use "-latest" aliases
# (e.g. gemini-flash-latest): they silently resolve to whatever model is
# newest, and the newest preview models carry drastically lower free
# limits - as low as ~20 requests/day, which one test session exhausts.
# Stable Flash models allow far more per day.
#
# If you hit HTTP 429, that's this problem. Run:
#   python scripts/check_setup.py
# which tells you exactly which model is exhausted and what to switch to.
# Your live per-model limits: https://aistudio.google.com/rate-limit
LLM_MODEL_ROUTER=google-gla:gemini-2.0-flash
LLM_MODEL_REASONING=google-gla:gemini-2.0-flash

# Only needed if you switch LLM_MODEL_* to openai:* models,
# or set EMBEDDING_PROVIDER=openai below. Leave blank otherwise.
OPENAI_API_KEY=


# --- Pinecone (vector database) ----------------------------------------
# Free Starter plan, no credit card. Get a key at: https://app.pinecone.io
# Keys start with "pcsk_". Paste the value only - no quotes, no spaces,
# and check you haven't picked up a stray character at the start
# (e.g. "Ppcsk_..." instead of "pcsk_..." causes a 401 Unauthorized).
PINECONE_API_KEY=
PINECONE_INDEX_NAME=nectar-facility-kb
PINECONE_CLOUD=aws
# The free Starter tier only supports us-east-1 - don't change this
# unless you're on a paid plan.
PINECONE_REGION=us-east-1


# --- Embeddings ---------------------------------------------------------
# 'pinecone' uses Pinecone's hosted embeddings (free tier allowance,
# reuses PINECONE_API_KEY - no third key needed). 'openai' requires
# OPENAI_API_KEY.
EMBEDDING_PROVIDER=pinecone

# Must match the provider AND the dimensions below:
#   pinecone → multilingual-e5-large     (1024 dims)
#   openai   → text-embedding-3-small    (1536 dims)
# Changing these means deleting and re-creating the Pinecone index.
EMBEDDING_MODEL=multilingual-e5-large
EMBEDDING_DIMENSIONS=1024


# --- Speech services ----------------------------------------------------
# faster-whisper: free, runs locally, no key. Model auto-downloads on
# first use (~75MB for 'base'). Options: tiny|base|small|medium|large-v3
STT_PROVIDER=faster-whisper
FASTER_WHISPER_MODEL=base

# edge-tts: free, no key, no signup.
# Run `edge-tts --list-voices` to see all available voices.
TTS_PROVIDER=edge-tts
EDGE_TTS_VOICE=en-US-AriaNeural

# Only needed if you switch STT_PROVIDER=deepgram or TTS_PROVIDER=elevenlabs
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=


# --- RAG behaviour ------------------------------------------------------
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.30
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120


# --- Routing behaviour --------------------------------------------------
ROUTER_MIN_CONFIDENCE=0.55


# --- Orchestration safety -----------------------------------------------
ORCHESTRATOR_MAX_STEPS=8
REQUIRE_CONFIRMATION_FOR_ACTIONS=true


# --- Web-sourced knowledge base -----------------------------------------
NECTAR_WEBSITE_URL=https://www.nectarit.com/


# --- MCP server ---------------------------------------------------------
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765
