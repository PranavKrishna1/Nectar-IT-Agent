        <mxCell id="a2" value="&lt;b&gt;1.&lt;/b&gt; router.route() → &lt;i&gt;mcp_live_data&lt;/i&gt;, high confidence&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;single specific live value; no docs or reasoning needed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="w1">
          <mxGeometry x="40" y="180" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;2.&lt;/b&gt; orchestrator_agent._handle_route&lt;br&gt;→ data_agent.answer_with_live_data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="w1">
          <mxGeometry x="40" y="270" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;3.&lt;/b&gt; Data agent (Pydantic AI + MCP tools) calls&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;get_asset_status(&quot;Chiller-01&quot;) over MCP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="w1">
          <mxGeometry x="40" y="355" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="&lt;b&gt;4.&lt;/b&gt; MCP server resolves against mock_facility_data.py&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;→ {&quot;asset_id&quot;: &quot;CHILLER-01&quot;, &quot;status&quot;: &quot;warning&quot;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="w1">
          <mxGeometry x="40" y="440" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="&lt;b&gt;5.&lt;/b&gt; Data agent → natural sentence; orchestrator returns it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="w1">
          <mxGeometry x="40" y="525" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="&lt;b&gt;6.&lt;/b&gt; voice/tts.py speaks the answer → &lt;b&gt;User&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="w1">
          <mxGeometry x="40" y="605" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="anote" value="Matches the brief:&#xa;User → LLM → MCP Tool → get_asset_status(&quot;Chiller-01&quot;)&#xa;→ Live Facility Data → LLM Reasoning → Voice Response" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="w1">
          <mxGeometry x="40" y="685" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ae1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="w1" source="a1" target="a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="w1" source="a2" target="a3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="w1" source="a3" target="a4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="w1" source="a4" target="a5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="w1" source="a5" target="a6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="w1" source="a6" target="a7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w2title" value="Walkthrough 2 — full multi-step investigation" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#b85450;" vertex="1" parent="w1">
          <mxGeometry x="520" y="60" width="480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;User:&lt;/b&gt; &quot;The office on the third floor feels very hot.&lt;br&gt;Can you investigate and let me know if we need maintenance?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="w1">
          <mxGeometry x="520" y="100" width="440" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;1.&lt;/b&gt; router.route() → &lt;i&gt;mcp_action&lt;/i&gt;, is_multi_step=True" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="w1">
          <mxGeometry x="520" y="185" width="440" height="45" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;2.&lt;/b&gt; orchestrator_agent._handle_action_route → action_agent.investigate()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="w1">
          <mxGeometry x="520" y="260" width="440" height="45" as="geometry" />
        </mxCell>
        <mxCell id="chain" value="&lt;b&gt;3. Action agent autonomously chains MCP read tools&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;verticalAlign=top;align=center;fontSize=12;spacingTop=6;fontColor=#8a6d1b;" vertex="1" parent="w1">
          <mxGeometry x="520" y="335" width="440" height="330" as="geometry" />
        </mxCell>
        <mxCell id="c3a" value="find_assets_by_location(&quot;Building A&quot;, &quot;ahu&quot;)&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;→ resolves &quot;third floor&quot; to AHU-02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="w1">
          <mxGeometry x="540" y="370" width="400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="c3b" value="get_asset_status(&quot;AHU-02&quot;) → &lt;b&gt;fault&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="w1">
          <mxGeometry x="540" y="430" width="400" height="35" as="geometry" />
        </mxCell>
        <mxCell id="c3c" value="get_sensor_data(&quot;AHU-02&quot;) → &lt;b&gt;410 CFM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;below the 650 CFM minimum (equipment_specifications.md)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="w1">
          <mxGeometry x="540" y="480" width="400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="c3d" value="get_active_alerts(&quot;AHU-02&quot;) → critical low-airflow alert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="w1">
          <mxGeometry x="540" y="540" width="400" height="35" as="geometry" />
        </mxCell>
        <mxCell id="c3e" value="get_asset_relationships(&quot;AHU-02&quot;) &lt;i&gt;(optional)&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;fed by Chiller-01 → rules out a chiller-side cause;&lt;br&gt;fault is local to the AHU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="w1">
          <mxGeometry x="540" y="590" width="400" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cnote" value="Read-only MCP tools here — no RAG. In the rag_mcp_reasoning route (&quot;why did X happen&quot;) the orchestrator additionally pulls the matching RAG document and synthesizes it with the live findings — see _handle_route&#39;s RAG_MCP_REASONING branch." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;dashed=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="w1">
          <mxGeometry x="520" y="680" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;4.&lt;/b&gt; Returns &lt;b&gt;ActionRecommendation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;action_warranted=True · asset_id=&quot;AHU-02&quot;&lt;br&gt;findings (low-airflow fault) + proposed_summary for the ticket&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="w1">
          <mxGeometry x="520" y="765" width="440" height="65" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;5.&lt;/b&gt; orchestrator builds a &lt;b&gt;PendingConfirmation&lt;/b&gt; on session state and asks:&lt;br&gt;&lt;i&gt;&quot;AHU-02 shows a low airflow fault at 410 CFM against a 650 CFM minimum,&lt;br&gt;with an active critical alert. Would you like me to create a maintenance&lt;br&gt;request for AHU-02?&quot;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#cc0000;strokeWidth=2;dashed=1;fontSize=12;" vertex="1" parent="w1">
          <mxGeometry x="520" y="860" width="440" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;6.&lt;/b&gt; Next turn — &lt;b&gt;User:&lt;/b&gt; &quot;yes, please&quot;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;confirmation.interpret_confirmation_reply → affirmative&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="w1">
          <mxGeometry x="520" y="975" width="440" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;7.&lt;/b&gt; confirmation.execute_confirmed_action&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;the ONLY call site of create_service_request in the codebase&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="w1">
          <mxGeometry x="520" y="1060" width="440" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;8.&lt;/b&gt; Orchestrator reports the created ticket ID back in speech → &lt;b&gt;User&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="w1">
          <mxGeometry x="520" y="1145" width="440" height="50" as="geometry" />
        </mxCell>
